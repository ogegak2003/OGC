# OGC mobile app configuration. Copy to `.env` (git-ignored) for local development.
# EXPO_PUBLIC_* values are compiled into the app and are PUBLIC — never put secrets here.
# Details: docs/development/mobile.md

# API base URL (REST under /v1, realtime under /realtime on the same origin).
# Leave unset for emulators/simulators in development:
#   Android emulator -> http://10.0.2.2:3000/api, iOS simulator -> http://localhost:3000/api
# Physical phone on the same Wi-Fi (development only) -> your computer's LAN address, e.g.:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:3000/api
# Preview/production builds REQUIRE a public HTTPS URL (enforced by app.config.ts):
#   EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.example/api
EXPO_PUBLIC_API_BASE_URL=

# Web app origin used in invitation links shared from the app.
# Development default: http://localhost:5173. Production: https://your-domain.example
EXPO_PUBLIC_WEB_APP_URL=

# Build profile: development (default) | preview | production
OGC_APP_ENV=development
