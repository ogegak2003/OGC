    "@ogc/ui": "workspace:*",
    "@ogc/validation": "workspace:*",
    "expo": "~58.0.7",
    "expo-asset": "~58.0.13",
    "expo-audio": "~58.0.8",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.10",
    "expo-crypto": "58.0.6",
    "expo-dev-client": "58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "58.0.3",
