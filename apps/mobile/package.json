  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@ogc/config": "workspace:*",
    "@ogc/eslint-config": "workspace:*",
    "@react-native/jest-preset": "0.87.1",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "~19.2.18",
    "eslint": "10.12.0",
    "jest": "29.7.0",
