{
  "name": "@ogc/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "OGC mobile client (Expo / React Native)",
  "license": "UNLICENSED",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
