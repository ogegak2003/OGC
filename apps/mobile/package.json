{
  "name": "@ogc/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "OGC mobile client (Expo / React Native)",
  "license": "UNLICENSED",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest",
    "doctor": "expo-doctor",
    "android:build": "node scripts/android-build.mjs",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@ogc/e2ee": "workspace:*",
    "@ogc/messaging": "workspace:*",
    "@ogc/types": "workspace:*",
    "@ogc/ui": "workspace:*",
    "@ogc/validation": "workspace:*",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-crypto": "57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@ogc/config": "workspace:*",
    "@ogc/eslint-config": "workspace:*",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "~19.2.18",
    "eslint": "10.12.0",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  }
}
