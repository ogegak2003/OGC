// OGC database schema. See docs/architecture/data-model.md.
//
// Conventions: UUIDv7 primary keys generated by the application, snake_case
// tables/columns, timestamps with time zone, secrets stored only as SHA-256
// hashes. Database-level CHECK constraints and the append-only audit trigger
// live in the migration SQL (Prisma does not model them).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CredentialType {
  PASSWORD
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
  DESKTOP
}

enum SessionRevocationReason {
  LOGOUT
  REFRESH_TOKEN_REUSE
  ACCOUNT_DISABLED
  /// Signed out from another of the account's devices (session management).
  USER_REVOKED
  /// The password changed: every other session ends.
  PASSWORD_CHANGED
  /// The password was reset from an emailed link: every session ends.
  PASSWORD_RESET
}

enum AuditEventType {
  USER_REGISTERED
  REGISTRATION_EMAIL_IN_USE
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  SESSION_CREATED
  SESSION_REFRESHED
  SESSION_REVOKED
  REFRESH_TOKEN_REUSE_DETECTED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_FAILED
  PROFILE_UPDATED
  PRIVACY_SETTINGS_CHANGED
  USER_BLOCKED
  USER_UNBLOCKED
  USER_REPORTED
  DEVICE_KEY_REGISTERED
  DEVICE_KEY_REVOKED
  CONVERSATION_CREATED
  MESSAGE_DELETED_FOR_EVERYONE
  GROUP_CREATED
  GROUP_MEMBER_REMOVED
  GROUP_OWNERSHIP_TRANSFERRED
  GROUP_DELETED
  CHANNEL_CREATED
  CHANNEL_OWNERSHIP_TRANSFERRED
  CHANNEL_VISIBILITY_CHANGED
  CHANNEL_DELETED
  CHANNEL_MODERATION
  INVITE_LINK_CREATED
  INVITE_LINK_REVOKED
  CONVERSATION_REPORTED
  PASSWORD_CHANGED
  PASSWORD_CHANGE_FAILED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_FAILED
  ACCOUNT_SUSPENDED
  ACCOUNT_REINSTATED
  RETENTION_PURGED
}

enum ProfileVisibility {
  EVERYONE
  CONTACTS
}

enum ContactRequestPolicy {
  EVERYONE
  NOBODY
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ReportCategory {
  SPAM
  HARASSMENT
  IMPERSONATION
  INAPPROPRIATE_CONTENT
  SCAM_OR_FRAUD
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum StaffRole {
  MODERATOR
  ADMIN
}

/// DIRECT = exactly two accounts; GROUP = private group; CHANNEL = private encrypted channel.
/// All three are end-to-end encrypted with MLS (ADR-022, ADR-031).
enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

/// Roles in groups and channels (MODERATOR exists in channels only). ADR-031.
enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum PostPolicy {
  ALL_MEMBERS
  MODERATORS
  ADMINS
}

enum InvitePolicy {
  ALL_MEMBERS
  ADMINS
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum ConversationEventType {
  CREATED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  ROLE_CHANGED
  OWNERSHIP_TRANSFERRED
  DETAILS_UPDATED
  MESSAGE_REMOVED
  ARCHIVED
  UNARCHIVED
}

enum NotificationLevel {
  ALL
  MENTIONS
  NONE
}

/// Community channels are server-readable (ADR-032).
enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

enum ChannelJoinPolicy {
  OPEN
  APPROVAL
}

enum ChannelMemberStatus {
  ACTIVE
  PENDING
  BANNED
}

enum ModerationActionType {
  REMOVE_POST
  RESTORE_POST
  SUSPEND
  UNSUSPEND
  BAN
  UNBAN
  REMOVE_MEMBER
  ROLE_CHANGED
  APPROVE_MEMBER
  REJECT_MEMBER
  RESOLVE_REPORT
  DISMISS_REPORT
  PIN_POST
  UNPIN_POST
  VISIBILITY_CHANGED
  OWNERSHIP_TRANSFERRED
  ARCHIVED
  UNARCHIVED
}

enum NotificationType {
  GROUP_INVITATION
  GROUP_MEMBER_ADDED
  GROUP_MEMBER_REMOVED
  GROUP_ROLE_CHANGED
  GROUP_DETAILS_CHANGED
  MENTION
  CHANNEL_ANNOUNCEMENT
  CHANNEL_ROLE_CHANGED
  CHANNEL_JOIN_REQUEST
  CHANNEL_REQUEST_APPROVED
  CHANNEL_MEMBER_REMOVED
  MODERATION_RESULT
  INVITATION_EXPIRED
}

/// Declared by the uploader; the server only sees ciphertext and enforces per-kind size limits.
enum AttachmentKind {
  IMAGE
  VIDEO
  AUDIO
  VOICE
  DOCUMENT
  FILE
}

enum CallMedia {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACCEPTED
  ENDED
}

enum CallOutcome {
  COMPLETED
  MISSED
  DECLINED
  CANCELLED
  BUSY
  FAILED
}

enum NotificationPreview {
  GENERIC
  SENDER
}

enum PushCategory {
  MESSAGE
  GROUP
  CHANNEL
  CALL
  CONTACT
  ACCOUNT
}

enum PushDeliveryStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
  EXPIRED
}

enum PushProvider {
  EXPO
  FCM
  APNS
}

/// An OGC account. Identity only: credentials, profile and sessions live in their own tables.
model User {
  id              String        @id @default(uuid(7)) @db.Uuid
  /// Public, immutable, randomly allocated identity (e.g. OGC482731905).
  ogcId           String        @unique @map("ogc_id") @db.VarChar(12)
  /// Normalised (lower-case) login and contact address.
  email           String        @unique @db.VarChar(254)
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  status          AccountStatus @default(PENDING_VERIFICATION)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile                 Profile?
  credentials             Credential[]
  devices                 Device[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  staffRoles              StaffRoleAssignment[]
  contactRequestsSent     ContactRequest[]          @relation("ContactRequestSender")
  contactRequestsReceived ContactRequest[]          @relation("ContactRequestRecipient")
  contacts                Contact[]                 @relation("ContactOwner")
  contactOf               Contact[]                 @relation("ContactTarget")
  blocksMade              Block[]                   @relation("Blocker")
  blocksReceived          Block[]                   @relation("Blocked")
  reportsMade             UserReport[]              @relation("Reporter")
  reportsReceived         UserReport[]              @relation("ReportedUser")
  deviceKeys              DeviceKey[]
  conversationsCreated    Conversation[]
  participations          ConversationParticipant[]
  messagesSent            Message[]
  reactions               MessageReaction[]
  messageHides            MessageHide[]
  attachmentsUploaded     Attachment[]
  invitationsSent         ConversationInvitation[]  @relation("InvitationsSent")
  invitationsReceived     ConversationInvitation[]  @relation("InvitationsReceived")
  inviteLinksCreated      InviteLink[]              @relation("InviteLinksCreated")
  conversationReportsMade ConversationReport[]      @relation("ConversationReportsMade")
  conversationReported    ConversationReport[]      @relation("ConversationReportsReceived")
  channelsCreated         Channel[]                 @relation("ChannelsCreated")
  channelMemberships      ChannelMember[]
  channelPosts            ChannelPost[]             @relation("ChannelPostsAuthored")
  channelReactions        ChannelPostReaction[]     @relation("ChannelReactions")
  notifications           Notification[]
  notificationSettings    NotificationSettings?
  pushDeliveries          PushDelivery[]
  callsMade               Call[]                    @relation("CallsMade")
  callsReceived           Call[]                    @relation("CallsReceived")

  @@map("users")
}

/// Public-facing presentation of a user, plus the privacy settings that govern its exposure.
model Profile {
  userId               String               @id @map("user_id") @db.Uuid
  /// Not unique: the OGC ID is the identifier (ADR-015).
  displayName          String               @map("display_name") @db.VarChar(64)
  bio                  String?              @db.VarChar(280)
  /// Server-generated object-storage key of the processed avatar; never a client filename.
  avatarKey            String?              @unique @map("avatar_key") @db.VarChar(128)
  profileVisibility    ProfileVisibility    @default(CONTACTS) @map("profile_visibility")
  discoverable         Boolean              @default(true)
  contactRequestPolicy ContactRequestPolicy @default(EVERYONE) @map("contact_request_policy")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// An authentication method. One row per method type per user; passkeys/OAuth add types later.
model Credential {
  id               String         @id @default(uuid(7)) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  type             CredentialType
  /// Argon2id PHC string. Never returned by any API or written to logs.
  secretHash       String         @map("secret_hash") @db.VarChar(255)
  failedLoginCount Int            @default(0) @map("failed_login_count")
  lockedUntil      DateTime?      @map("locked_until") @db.Timestamptz(3)
  lastUsedAt       DateTime?      @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("credentials")
}

/// A client installation or browser. Anchor for future per-device encryption keys (ADR-012).
model Device {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  platform   DevicePlatform
  /// Client-supplied, user-visible label (untrusted).
  name       String?        @db.VarChar(64)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        Session[]
  keys            DeviceKey[]
  pushToken       PushToken?
  pushDeliveries  PushDelivery[]
  callsMadeFrom   Call[]         @relation("CallerDevice")
  callsAnsweredOn Call[]         @relation("CalleeDevice")

  @@index([userId])
  @@map("devices")
}

/// An authenticated session on one device. Tokens are opaque; only their SHA-256 hashes are stored.
model Session {
  id               String                   @id @default(uuid(7)) @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  deviceId         String                   @map("device_id") @db.Uuid
  accessTokenHash  String                   @unique @map("access_token_hash") @db.Char(64)
  accessExpiresAt  DateTime                 @map("access_expires_at") @db.Timestamptz(3)
  /// Hash of the current refresh token; replaced on every rotation.
  refreshTokenHash String                   @map("refresh_token_hash") @db.Char(64)
  /// Absolute lifetime: the session cannot be refreshed past this point.
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime                 @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revocationReason SessionRevocationReason? @map("revocation_reason")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@map("sessions")
}

/// Single-use email verification secret (hashed), valid for a limited time.
model EmailVerificationToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Single-use password-reset secret (hashed), valid for a short time. Issuing a new one or
/// completing a reset supersedes every other outstanding token of the account.
model PasswordResetToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Preservation hold (security investigation or legal request): while a hold exists, retention
/// cleanup skips the account's sessions and audit events. No foreign key, like the audit log.
/// Created and released by operators only.
model RetentionHold {
  userId    String   @id @map("user_id") @db.Uuid
  reason    String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("retention_holds")
}

/// Append-only security event log. No foreign keys: audit history outlives the records it describes.
/// UPDATE and DELETE are rejected by a database trigger.
model AuditEvent {
  id        String         @id @default(uuid(7)) @db.Uuid
  type      AuditEventType
  userId    String?        @map("user_id") @db.Uuid
  sessionId String?        @map("session_id") @db.Uuid
  ipAddress String?        @map("ip_address") @db.Inet
  userAgent String?        @map("user_agent") @db.VarChar(256)
  /// Non-sensitive context only (e.g. failure reason). Never credentials or tokens.
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("audit_events")
}

/// Platform staff roles (moderation, administration). Granted only by operators, never by clients.
model StaffRoleAssignment {
  userId    String    @map("user_id") @db.Uuid
  role      StaffRole
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("staff_roles")
}

/// A request to become contacts. At most one PENDING request per pair of users (partial unique index).
model ContactRequest {
  id          String               @id @default(uuid(7)) @db.Uuid
  senderId    String               @map("sender_id") @db.Uuid
  recipientId String               @map("recipient_id") @db.Uuid
  status      ContactRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  respondedAt DateTime?            @map("responded_at") @db.Timestamptz(3)

  sender    User @relation("ContactRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ContactRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status, id])
  @@index([senderId, status, id])
  @@map("contact_requests")
}

/// An accepted contact, stored once per direction so each side can be listed and annotated cheaply.
model Contact {
  id        String   @id @default(uuid(7)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner   User @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact User @relation("ContactTarget", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactId])
  @@index([ownerId, id])
  @@index([contactId])
  @@map("contacts")
}

/// One user blocking another. Independent of contact state.
model Block {
  id        String   @id @default(uuid(7)) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId, id])
  @@index([blockedId])
  @@map("blocks")
}

/// A user's report about another user, for moderators. Survives deletion of either account.
model UserReport {
  id             String         @id @default(uuid(7)) @db.Uuid
  reporterId     String?        @map("reporter_id") @db.Uuid
  reportedUserId String?        @map("reported_user_id") @db.Uuid
  category       ReportCategory
  description    String?        @db.VarChar(1000)
  status         ReportStatus   @default(OPEN)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter     User? @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([status, id])
  @@index([reportedUserId])
  @@index([reporterId, createdAt])
  @@map("user_reports")
}

/// A device's end-to-end encryption identity: an Ed25519 signature public key used for its
/// MLS credential (ADR-024). The private key never leaves the device. At most one active
/// (non-revoked) key per device (partial unique index in the migration).
model DeviceKey {
  /// Random (v4) public identifier embedded in MLS credentials; reveals nothing about time.
  id                 String    @id @db.Uuid
  deviceId           String    @map("device_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  signaturePublicKey Bytes     @unique @map("signature_public_key")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)

  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyPackages  KeyPackage[]
  welcomes     MlsWelcome[]
  messagesSent Message[]

  @@index([userId])
  @@index([deviceId])
  @@map("device_keys")
}

/// One-time MLS KeyPackage published by a device so others can add it to conversations.
model KeyPackage {
  id          String    @id @default(uuid(7)) @db.Uuid
  deviceKeyId String    @map("device_key_id") @db.Uuid
  /// Hex KeyPackageRef (RFC 9420 §5.2).
  ref         String    @unique @db.Char(64)
  data        Bytes
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  deviceKey DeviceKey @relation(fields: [deviceKeyId], references: [id], onDelete: Cascade)

  @@index([deviceKeyId, claimedAt])
  @@map("key_packages")
}

/// A conversation. `version` is a per-conversation change counter: every message, edit,
/// deletion, reaction, hide and MLS commit takes the next value under a row lock, so
/// versions are strictly increasing in commit order (ADR-025).
model Conversation {
  /// Random (v4) opaque identifier; also the MLS group ID.
  id               String           @id @db.Uuid
  type             ConversationType
  /// DIRECT only: "<smaller user id>:<larger user id>" — one conversation per pair (unique).
  directKey        String?          @unique @map("direct_key") @db.VarChar(73)
  version          BigInt           @default(0)
  /// Current MLS epoch accepted by the delivery service (compare-and-set on commits).
  mlsEpoch         BigInt           @default(0) @map("mls_epoch")
  /// Latest MLS GroupInfo (public data: ratchet tree, external public key) for `mlsEpoch`.
  groupInfo        Bytes?           @map("group_info")
  /// Accounts whose devices are in the current MLS tree (from the latest accepted commit).
  /// New messages are refused while it contains anyone who is no longer a participant (ADR-033).
  mlsMemberUserIds String[]         @default([]) @map("mls_member_user_ids") @db.Uuid
  lastActivityAt   DateTime         @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdById      String?          @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)

  createdBy    User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
  commits      MlsCommit[]
  welcomes     MlsWelcome[]
  attachments  Attachment[]
  hides        MessageHide[]
  groupProfile GroupProfile?
  invitations  ConversationInvitation[]
  inviteLinks  InviteLink[]
  events       ConversationEvent[]
  reports      ConversationReport[]
  calls        Call[]

  @@index([updatedAt, id])
  @@map("conversations")
}

/// Membership plus per-user read/delivery high-water marks (message `seq` values).
model ConversationParticipant {
  conversationId     String            @map("conversation_id") @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  lastReadSeq        BigInt            @default(0) @map("last_read_seq")
  lastDeliveredSeq   BigInt            @default(0) @map("last_delivered_seq")
  readAt             DateTime?         @map("read_at") @db.Timestamptz(3)
  /// Groups and channels only; DIRECT participants are always MEMBER.
  role               CommunityRole     @default(MEMBER)
  notificationLevel  NotificationLevel @default(ALL) @map("notification_level")
  mutedUntil         DateTime?         @map("muted_until") @db.Timestamptz(3)
  /// Groups: history starts after this version — members never receive what was sent
  /// before they joined (they could not decrypt it anyway). 0 for DIRECT conversations.
  visibleFromVersion BigInt            @default(0) @map("visible_from_version")
  joinedAt           DateTime          @default(now()) @map("joined_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, conversationId])
  @@map("conversation_participants")
}

/// An end-to-end encrypted message. The server stores only the MLS ciphertext and the
/// metadata needed for routing, ordering and authorization (ADR-022, ADR-024).
model Message {
  id                String    @id @default(uuid(7)) @db.Uuid
  conversationId    String    @map("conversation_id") @db.Uuid
  /// Position in the conversation (the conversation version when it was created).
  seq               BigInt
  /// Conversation version of the latest change to this message (edit, delete, reaction).
  version           BigInt
  senderId          String?   @map("sender_id") @db.Uuid
  senderDeviceKeyId String?   @map("sender_device_key_id") @db.Uuid
  /// Client-generated idempotency key (UUID): retries never create duplicates.
  clientMessageId   String    @map("client_message_id") @db.Uuid
  /// MLS epoch of the current ciphertext.
  epoch             BigInt
  /// MLS PrivateMessage; NULL once deleted for everyone.
  ciphertext        Bytes?
  replyToId         String?   @map("reply_to_id") @db.Uuid
  forwarded         Boolean   @default(false)
  revision          Int       @default(0)
  editedAt          DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Sent while the recipient had blocked the sender: never delivered to the recipient.
  withheld          Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderDeviceKey DeviceKey?        @relation(fields: [senderDeviceKeyId], references: [id], onDelete: SetNull)
  /// Composite key: a reply can only reference a message in the same conversation.
  replyTo         Message?          @relation("Replies", fields: [conversationId, replyToId], references: [conversationId, id], onDelete: NoAction, onUpdate: NoAction)
  replies         Message[]         @relation("Replies")
  edits           MessageEdit[]
  reactions       MessageReaction[]
  hides           MessageHide[]
  attachments     Attachment[]

  @@unique([conversationId, seq])
  @@unique([conversationId, id])
  @@unique([senderId, clientMessageId])
  @@index([conversationId, version])
  @@map("messages")
}

/// Edit history metadata (who, when, which revision). Earlier ciphertexts are not kept.
model MessageEdit {
  id                String   @id @default(uuid(7)) @db.Uuid
  messageId         String   @map("message_id") @db.Uuid
  revision          Int
  editorDeviceKeyId String?  @map("editor_device_key_id") @db.Uuid
  editedAt          DateTime @default(now()) @map("edited_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, revision])
  @@map("message_edits")
}

/// One reaction of a given type per user per message. Reaction types come from a fixed set
/// (CHECK constraint) and are visible to the server (ADR-022).
model MessageReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reaction  String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, reaction])
  @@map("message_reactions")
}

/// "Delete for me": hides a message from one user's devices only.
model MessageHide {
  userId         String   @map("user_id") @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  version        BigInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([userId, conversationId, version])
  @@map("message_hides")
}

/// Accepted MLS commits, one per epoch (the primary key is the compare-and-set guarantee).
model MlsCommit {
  conversationId    String   @map("conversation_id") @db.Uuid
  /// The epoch the commit was created in; applying it yields epoch + 1.
  epoch             BigInt
  version           BigInt
  data              Bytes
  senderDeviceKeyId String?  @map("sender_device_key_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, epoch])
  @@index([conversationId, version])
  @@map("mls_commits")
}

/// An MLS Welcome waiting for one target device; deleted once the device has joined.
model MlsWelcome {
  id             String   @id @default(uuid(7)) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  deviceKeyId    String   @map("device_key_id") @db.Uuid
  /// The epoch the device joins at.
  epoch          BigInt
  data           Bytes
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deviceKey    DeviceKey    @relation(fields: [deviceKeyId], references: [id], onDelete: Cascade)

  @@unique([deviceKeyId, conversationId, epoch])
  @@index([deviceKeyId, id])
  @@map("mls_welcomes")
}

/// An encrypted attachment blob. The server stores ciphertext only; the key travels inside
/// the MLS-encrypted message (ADR-027).
model Attachment {
  /// Random (v4) opaque identifier.
  id             String         @id @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  uploaderId     String?        @map("uploader_id") @db.Uuid
  messageId      String?        @map("message_id") @db.Uuid
  kind           AttachmentKind
  size           Int
  /// SHA-256 of the ciphertext.
  sha256         Bytes
  storageKey     String         @unique @map("storage_key") @db.VarChar(128)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploader     User?        @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([uploaderId, createdAt])
  @@map("attachments")
}

/// The push notification token of one device. Notifications never contain message content.
model PushToken {
  deviceId  String       @id @map("device_id") @db.Uuid
  provider  PushProvider
  token     String       @db.VarChar(512)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([provider, token])
  @@map("push_tokens")
}

/// Settings of a GROUP or private encrypted CHANNEL conversation (ADR-031). Names, descriptions
/// and photos are server-visible metadata; message content stays end-to-end encrypted.
model GroupProfile {
  conversationId String       @id @map("conversation_id") @db.Uuid
  name           String       @db.VarChar(64)
  description    String?      @db.VarChar(500)
  /// Server-generated object-storage key of the processed photo.
  avatarKey      String?      @unique @map("avatar_key") @db.VarChar(128)
  /// Who may post (encrypted channels default to ADMINS; groups to ALL_MEMBERS).
  postPolicy     PostPolicy   @default(ALL_MEMBERS) @map("post_policy")
  /// Who may invite people.
  invitePolicy   InvitePolicy @default(ADMINS) @map("invite_policy")
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("group_profiles")
}

/// A personal invitation to join a group or encrypted channel; the invitee must accept.
/// At most one PENDING invitation per conversation and invitee (partial unique index).
model ConversationInvitation {
  id             String           @id @default(uuid(7)) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  inviterId      String?          @map("inviter_id") @db.Uuid
  inviteeId      String           @map("invitee_id") @db.Uuid
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  respondedAt    DateTime?        @map("responded_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("InvitationsSent", fields: [inviterId], references: [id], onDelete: SetNull)
  invitee      User         @relation("InvitationsReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status, id])
  @@index([conversationId, status])
  @@map("conversation_invitations")
}

/// A shareable invitation link (ADR-034). Only the SHA-256 of the 256-bit token is stored.
/// Targets exactly one group/encrypted channel or one community channel.
model InviteLink {
  id             String    @id @default(uuid(7)) @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  conversationId String?   @map("conversation_id") @db.Uuid
  channelId      String?   @map("channel_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  maxUses        Int?      @map("max_uses")
  useCount       Int       @default(0) @map("use_count")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("InviteLinksCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([channelId, createdAt])
  @@map("invite_links")
}

/// Append-only membership and settings history of a group/encrypted channel. Feeds the
/// timeline ("Ada added Grace") through sync and doubles as an audit trail. Never content.
model ConversationEvent {
  id             String                @id @default(uuid(7)) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  version        BigInt
  type           ConversationEventType
  actorId        String?               @map("actor_id") @db.Uuid
  subjectId      String?               @map("subject_id") @db.Uuid
  /// Non-sensitive details (e.g. the new role). Never message content.
  detail         Json?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, version])
  @@map("conversation_events")
}

/// A report about a message in an end-to-end encrypted conversation. The reporter explicitly
/// discloses the decrypted text to OGC's moderators; the server could not read it otherwise.
model ConversationReport {
  id             String         @id @default(uuid(7)) @db.Uuid
  reporterId     String?        @map("reporter_id") @db.Uuid
  conversationId String?        @map("conversation_id") @db.Uuid
  messageId      String?        @map("message_id") @db.Uuid
  reportedUserId String?        @map("reported_user_id") @db.Uuid
  category       ReportCategory
  /// Plaintext the reporter chose to disclose (≤ 4000 chars). Never collected otherwise.
  disclosedText  String?        @map("disclosed_text") @db.VarChar(4000)
  description    String?        @db.VarChar(1000)
  status         ReportStatus   @default(OPEN)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  reporter     User?         @relation("ConversationReportsMade", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser User?         @relation("ConversationReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, id])
  @@index([reporterId, createdAt])
  @@map("conversation_reports")
}

/// A community channel: server-readable (NOT end-to-end encrypted), for larger audiences (ADR-032).
model Channel {
  /// Random (v4) identifier.
  id             String            @id @db.Uuid
  /// Public handle for links and search (lower-case, unique).
  handle         String            @unique @db.VarChar(32)
  name           String            @db.VarChar(64)
  description    String?           @db.VarChar(1000)
  avatarKey      String?           @unique @map("avatar_key") @db.VarChar(128)
  visibility     ChannelVisibility @default(PUBLIC)
  joinPolicy     ChannelJoinPolicy @default(OPEN) @map("join_policy")
  postPolicy     PostPolicy        @default(ADMINS) @map("post_policy")
  /// Members may reply to posts (discussion).
  repliesEnabled Boolean           @default(true) @map("replies_enabled")
  version        BigInt            @default(0)
  memberCount    Int               @default(0) @map("member_count")
  lastPostAt     DateTime?         @map("last_post_at") @db.Timestamptz(3)
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User?                     @relation("ChannelsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  members     ChannelMember[]
  posts       ChannelPost[]
  inviteLinks InviteLink[]
  moderation  ChannelModerationAction[]
  reports     ChannelPostReport[]

  @@index([visibility, memberCount])
  @@map("channels")
}

model ChannelMember {
  channelId         String              @map("channel_id") @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  role              CommunityRole       @default(MEMBER)
  status            ChannelMemberStatus @default(ACTIVE)
  /// Posting suspended until this time (moderation).
  suspendedUntil    DateTime?           @map("suspended_until") @db.Timestamptz(3)
  notificationLevel NotificationLevel   @default(ALL) @map("notification_level")
  mutedUntil        DateTime?           @map("muted_until") @db.Timestamptz(3)
  lastReadSeq       BigInt              @default(0) @map("last_read_seq")
  joinedAt          DateTime            @default(now()) @map("joined_at") @db.Timestamptz(3)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId, status])
  @@index([channelId, status, role])
  @@map("channel_members")
}

model ChannelPost {
  id           String    @id @default(uuid(7)) @db.Uuid
  channelId    String    @map("channel_id") @db.Uuid
  seq          BigInt
  version      BigInt
  authorId     String?   @map("author_id") @db.Uuid
  /// Idempotency key from the client.
  clientPostId String    @map("client_post_id") @db.Uuid
  body         String?   @db.VarChar(4000)
  replyToId    String?   @map("reply_to_id") @db.Uuid
  announcement Boolean   @default(false)
  pinnedAt     DateTime? @map("pinned_at") @db.Timestamptz(3)
  editedAt     DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Removed by a moderator (restorable); the body is kept for review until restored or purged.
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  channel     Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User?                 @relation("ChannelPostsAuthored", fields: [authorId], references: [id], onDelete: SetNull)
  replyTo     ChannelPost?          @relation("ChannelReplies", fields: [channelId, replyToId], references: [channelId, id], onDelete: NoAction, onUpdate: NoAction)
  replies     ChannelPost[]         @relation("ChannelReplies")
  reactions   ChannelPostReaction[]
  attachments ChannelAttachment[]
  reports     ChannelPostReport[]

  @@unique([channelId, seq])
  @@unique([channelId, id])
  @@unique([authorId, clientPostId])
  @@index([channelId, version])
  @@index([channelId, pinnedAt])
  @@map("channel_posts")
}

model ChannelPostReaction {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reaction  String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation("ChannelReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, reaction])
  @@map("channel_post_reactions")
}

/// A server-readable attachment on a community channel post (images are re-encoded).
model ChannelAttachment {
  id         String         @id @db.Uuid
  channelId  String         @map("channel_id") @db.Uuid
  uploaderId String?        @map("uploader_id") @db.Uuid
  postId     String?        @map("post_id") @db.Uuid
  kind       AttachmentKind
  name       String         @db.VarChar(255)
  mime       String         @db.VarChar(127)
  size       Int
  storageKey String         @unique @map("storage_key") @db.VarChar(128)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  post ChannelPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([postId, createdAt])
  @@map("channel_attachments")
}

/// Append-only record of moderator actions with reasons (ADR-035).
model ChannelModerationAction {
  id           String               @id @default(uuid(7)) @db.Uuid
  channelId    String               @map("channel_id") @db.Uuid
  moderatorId  String?              @map("moderator_id") @db.Uuid
  action       ModerationActionType
  targetUserId String?              @map("target_user_id") @db.Uuid
  targetPostId String?              @map("target_post_id") @db.Uuid
  reason       String?              @db.VarChar(500)
  until        DateTime?            @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, id])
  @@map("channel_moderation_actions")
}

model ChannelPostReport {
  id          String         @id @default(uuid(7)) @db.Uuid
  channelId   String         @map("channel_id") @db.Uuid
  postId      String         @map("post_id") @db.Uuid
  reporterId  String?        @map("reporter_id") @db.Uuid
  category    ReportCategory
  description String?        @db.VarChar(1000)
  status      ReportStatus   @default(OPEN)
  resolution  String?        @db.VarChar(500)
  resolvedAt  DateTime?      @map("resolved_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  channel Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  post    ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([channelId, status, id])
  @@map("channel_post_reports")
}

/// In-app notification (ADR-036). Payloads carry IDs and public names only — never message content.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  /// Idempotency key: the same event never notifies a user twice.
  dedupeKey String           @map("dedupe_key") @db.VarChar(200)
  data      Json
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, id])
  @@map("notifications")
}

/// One-to-one voice/video call (Phase 6, ADR-037). Signaling state and history metadata only:
/// no audio, video, session descriptions or network addresses are ever stored.
model Call {
  id               String       @id @default(uuid(7)) @db.Uuid
  /// The DIRECT conversation the call belongs to.
  conversationId   String       @map("conversation_id") @db.Uuid
  callerId         String       @map("caller_id") @db.Uuid
  calleeId         String       @map("callee_id") @db.Uuid
  /// The device that started the call; signaling is relayed to it only.
  callerDeviceId   String?      @map("caller_device_id") @db.Uuid
  /// The device that answered (set on accept); the callee's other devices stop ringing.
  calleeDeviceId   String?      @map("callee_device_id") @db.Uuid
  media            CallMedia
  status           CallStatus   @default(RINGING)
  outcome          CallOutcome?
  /// The callee had blocked the caller when the call started: never delivered or shown to the
  /// callee, so the block is not revealed (the caller sees no answer).
  hiddenFromCallee Boolean      @default(false) @map("hidden_from_callee")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  answeredAt       DateTime?    @map("answered_at") @db.Timestamptz(3)
  /// First report from either device that media is flowing; durations are measured from here.
  connectedAt      DateTime?    @map("connected_at") @db.Timestamptz(3)
  endedAt          DateTime?    @map("ended_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User         @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  callee       User         @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)
  callerDevice Device?      @relation("CallerDevice", fields: [callerDeviceId], references: [id], onDelete: SetNull)
  calleeDevice Device?      @relation("CalleeDevice", fields: [calleeDeviceId], references: [id], onDelete: SetNull)

  @@index([callerId, id])
  @@index([calleeId, id])
  @@index([conversationId, id])
  /// Open calls (sweeper, busy checks) and retention of ended calls by age.
  @@index([status, createdAt])
  @@map("calls")
}

/// Account-wide push preferences (Phase 7, ADR-038). One row per account, created on first
/// change; absent means the defaults below. Per-conversation mute/level stay on participants.
model NotificationSettings {
  userId            String              @id @map("user_id") @db.Uuid
  enabled           Boolean             @default(true)
  messages          Boolean             @default(true)
  groups            Boolean             @default(true)
  channels          Boolean             @default(true)
  contactRequests   Boolean             @default(true) @map("contact_requests")
  calls             Boolean             @default(true)
  preview           NotificationPreview @default(GENERIC)
  sound             Boolean             @default(true)
  vibration         Boolean             @default(true)
  quietHoursEnabled Boolean             @default(false) @map("quiet_hours_enabled")
  /// Minutes after local midnight (0–1439); the window may wrap past midnight.
  quietStart        Int                 @default(1320) @map("quiet_start")
  quietEnd          Int                 @default(420) @map("quiet_end")
  /// IANA time zone of the quiet hours (validated by the API).
  timeZone          String              @default("UTC") @map("time_zone") @db.VarChar(64)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// Durable push delivery queue (Phase 7, ADR-038): one row per notification per device.
/// Content is fixed generic text (plus a name when the recipient chose sender previews) —
/// never message content. Rows are claimed with FOR UPDATE SKIP LOCKED, retried with
/// backoff, and deleted after the retention period.
model PushDelivery {
  id            String             @id @default(uuid(7)) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  deviceId      String             @map("device_id") @db.Uuid
  category      PushCategory
  /// Idempotency: the same event never queues twice for a device.
  dedupeKey     String             @map("dedupe_key") @db.VarChar(200)
  title         String             @db.VarChar(120)
  body          String             @db.VarChar(120)
  /// Routing only (IDs), see PushData in @ogc/types.
  data          Json
  /// Quiet hours, or sound and vibration turned off: delivered without either.
  sound         Boolean            @default(true)
  vibration     Boolean            @default(true)
  /// Calls: high priority; everything else normal.
  urgent        Boolean            @default(false)
  status        PushDeliveryStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  /// A worker owns a SENDING row until then (a crashed worker's rows are reclaimed).
  lockedUntil   DateTime?          @map("locked_until") @db.Timestamptz(3)
  /// Not worth delivering after this (an incoming call that stopped ringing).
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(3)
  /// Provider receipt handle (Expo ticket ID).
  ticketId      String?            @map("ticket_id") @db.VarChar(100)
  /// Last provider or delivery error code (never the token or content).
  lastError     String?            @map("last_error") @db.VarChar(64)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sentAt        DateTime?          @map("sent_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, dedupeKey])
  /// The worker's queue scan, the receipt check and retention.
  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("push_deliveries")
}
