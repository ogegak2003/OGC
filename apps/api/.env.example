# OGC API — example configuration.
# Copy to `.env` for local development. Never commit real values.
# All variables are validated at startup (src/config/env.schema.ts).

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Comma-separated list of exact origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Set to the number of trusted reverse-proxy hops in front of the API (0 = none).
TRUST_PROXY_HOPS=0

# Global rate limit: at most RATE_LIMIT_MAX requests per RATE_LIMIT_TTL_MS per client.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Local development database (matches infrastructure/docker/docker-compose.yml).
# Use a least-privilege role and TLS (sslmode=require) in deployed environments.
DATABASE_URL=postgresql://ogc:change-me-local-only@localhost:5432/ogc?schema=public

# Public URL of the web client, used in links inside emails (https:// in production).
WEB_APP_URL=http://localhost:5173

# Email delivery (docs/security/account-recovery.md):
#   disabled  nothing is sent; password recovery answers "unavailable" (default)
#   outbox    development only: each email is written to a file in EMAIL_OUTBOX_DIR
#             (open it to follow verification and password-reset links)
#   smtp      any SMTP provider (SES, Postmark, SendGrid, Mailgun…); TLS required in production
EMAIL_TRANSPORT=outbox
EMAIL_OUTBOX_DIR=.dev-outbox
# EMAIL_FROM=OGC <no-reply@mail.example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | tls | none (none: local mail catchers only)
# SMTP_USER=
# SMTP_PASSWORD=                # a secret: set it from your secret manager, never commit it
# PASSWORD_RESET_TTL_MINUTES=30

# Retention cleanup (docs/operations/data-retention.md). Defaults shown.
# RETENTION_ENABLED=true
# RETENTION_INTERVAL_MS=3600000
# RETENTION_SESSION_DAYS=90     # ended sessions (min 7)
# RETENTION_TOKEN_DAYS=7        # used/expired verification and reset tokens
# AUDIT_RETENTION_DAYS=730      # min 365, also enforced by the database
# REALTIME_SESSION_CHECK_MS=30000

# Production only: TLS to PostgreSQL and Redis (sslmode=require|verify-ca|verify-full, rediss://)
# is required unless both run on a private single-host network (docs/operations/deployment.md).
# DATABASE_TLS=required
# REDIS_TLS=required

# Auth cookies get the Secure flag and __Host-/__Secure- prefixes when true.
# Defaults to true in production (required there) and false otherwise.
# COOKIE_SECURE=false

# Disposable database for integration tests (name must end in _test; it is reset on every run).
TEST_DATABASE_URL=postgresql://ogc:change-me-local-only@localhost:5432/ogc_test?schema=public
# Redis for integration tests of the shared rate-limit and presence stores (database 15).
TEST_REDIS_URL=redis://:change-me-local-redis-password@localhost:6380/15

# Media storage for profile photos: `disabled` (uploads refused) or `local` (development only:
# files under STORAGE_LOCAL_DIR). Production will use an object-storage adapter.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.dev-storage

# Redis: shared rate limits, presence and realtime fan-out (required in production).
# Optional for a single local instance; matches infrastructure/docker/.env.
# REDIS_URL=redis://:change-me-local-redis-password@localhost:6380/0

# Metrics endpoint bearer token (GET /api/v1/metrics). Unset = endpoint disabled.
# METRICS_TOKEN=

# Push notifications: disabled | outbox (development) | expo.
PUSH_PROVIDER=disabled

# One-to-one calls (docs/development/calls.md). All optional: with nothing set, calls work
# between devices on the same network and no external STUN/TURN provider is contacted.
# WEBRTC_STUN_URLS=stun:turn.example.org:3478
# WEBRTC_TURN_URLS=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:5349?transport=tcp
# Shared with coturn's static-auth-secret; at least 32 characters, from your secret store.
# WEBRTC_TURN_SECRET=replace-with-a-long-random-secret
# WEBRTC_TURN_CREDENTIAL_TTL_SECONDS=3600
# `relay` hides participants' IP addresses from each other (requires TURN).
# WEBRTC_ICE_TRANSPORT_POLICY=all
# CALL_RING_TIMEOUT_SECONDS=45
# CALL_CONNECT_TIMEOUT_SECONDS=30
# CALL_RECONNECT_GRACE_SECONDS=20
# CALL_HISTORY_RETENTION_DAYS=365
# RATE_LIMIT_CALL_START=10
# RATE_LIMIT_CALL_SIGNAL=600
