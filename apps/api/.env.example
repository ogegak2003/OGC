# OGC API — example configuration.
# Copy to `.env` for local development. Never commit real values.
# All variables are validated at startup (src/config/env.schema.ts).

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Comma-separated list of exact origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Set to the number of trusted reverse-proxy hops in front of the API (0 = none).
TRUST_PROXY_HOPS=0

# Global rate limit: at most RATE_LIMIT_MAX requests per RATE_LIMIT_TTL_MS per client.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Local development database (matches infrastructure/docker/docker-compose.yml).
# Use a least-privilege role and TLS (sslmode=require) in deployed environments.
DATABASE_URL=postgresql://ogc:change-me-local-only@localhost:5432/ogc?schema=public

# Public URL of the web client, used in links inside emails (https:// in production).
WEB_APP_URL=http://localhost:5173

# Email delivery: `disabled` (default; nothing is sent) or `outbox` (development only:
# each email is written to a file in EMAIL_OUTBOX_DIR — open it to follow verification links).
EMAIL_TRANSPORT=outbox
EMAIL_OUTBOX_DIR=.dev-outbox

# Auth cookies get the Secure flag and __Host-/__Secure- prefixes when true.
# Defaults to true in production (required there) and false otherwise.
# COOKIE_SECURE=false

# Disposable database for integration tests (name must end in _test; it is reset on every run).
TEST_DATABASE_URL=postgresql://ogc:change-me-local-only@localhost:5432/ogc_test?schema=public
# Redis for integration tests of the shared rate-limit and presence stores (database 15).
TEST_REDIS_URL=redis://:change-me-local-redis-password@localhost:6380/15

# Media storage for profile photos: `disabled` (uploads refused) or `local` (development only:
# files under STORAGE_LOCAL_DIR). Production will use an object-storage adapter.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.dev-storage

# Redis: shared rate limits, presence and realtime fan-out (required in production).
# Optional for a single local instance; matches infrastructure/docker/.env.
# REDIS_URL=redis://:change-me-local-redis-password@localhost:6380/0

# Metrics endpoint bearer token (GET /api/v1/metrics). Unset = endpoint disabled.
# METRICS_TOKEN=

# Push notifications: disabled | outbox (development) | expo.
PUSH_PROVIDER=disabled
