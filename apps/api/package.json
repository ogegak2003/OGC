    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.2",
    "@node-rs/argon2": "2.2.2",
    "@ogc/e2ee": "workspace:*",
    "@ogc/types": "workspace:*",
    "@ogc/validation": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@socket.io/redis-adapter": "8.3.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
