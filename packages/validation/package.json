{
  "name": "@ogc/validation",
  "version": "0.0.0",
  "private": true,
  "description": "Shared runtime validation schemas for OGC applications",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
