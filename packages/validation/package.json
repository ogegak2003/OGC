  "dependencies": {
    "@ogc/types": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ogc/config": "workspace:*",
    "@ogc/eslint-config": "workspace:*",
    "eslint": "10.12.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.4"
  }
