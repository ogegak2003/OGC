{
  "name": "ogc",
  "version": "0.0.0",
  "private": true,
  "description": "OGC — ObagaGlobal Communication platform monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck build && pnpm test",
    "audit:deps": "pnpm audit --audit-level=high",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "backup:check": "bash infrastructure/backup/test-backup-restore.sh",
    "deploy:check-context": "bash infrastructure/docker/tests/check-build-context.sh",
    "deploy:check-stack": "bash infrastructure/docker/tests/check-prod-stack.sh"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "~6.0.3"
  }
}
