# Local Docker Compose settings. Copy to `.env` in this directory.
# These are for local development only — never reuse them in any deployed environment.

POSTGRES_DB=ogc
POSTGRES_USER=ogc
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=8080

# Redis (rate limits, presence, realtime fan-out). Local only; generate your own value.
REDIS_PASSWORD=change-me-local-redis-password
REDIS_PORT=6380

# Calls (optional). Placeholders only; keep a real TURN secret in your secret store.
# WEBRTC_STUN_URLS=stun:turn.example.org:3478
# WEBRTC_TURN_URLS=turn:turn.example.org:3478?transport=udp
# WEBRTC_TURN_SECRET=replace-with-a-long-random-secret
