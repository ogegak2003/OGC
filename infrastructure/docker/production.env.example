# OGC staging/production settings for docker-compose.prod.yml (docs/operations/deployment.md).
#
# Copy OUTSIDE the repository, e.g.  sudo install -m 600 -o root -g root \
#   infrastructure/docker/production.env.example /etc/ogc/production.env
# then replace every REPLACE_… value. Never commit the real file, never paste it into chats or
# tickets, and never `cat` it on a shared screen. Generate secrets with:
#   openssl rand -base64 33 | tr -d '/+=' | cut -c1-40
# The API refuses to start with these placeholders (weak or placeholder secret).

# Public hostname (no scheme, no port). Its DNS A/AAAA record must point at this server.
OGC_DOMAIN=REPLACE_WITH_YOUR_DOMAIN
# Directory on the host holding fullchain.pem and privkey.pem for OGC_DOMAIN.
TLS_CERT_DIR=/etc/ogc/tls
# Webroot that certbot writes HTTP-01 challenges to.
ACME_WEBROOT=/var/www/ogc-acme

# Database (internal network only; never published).
POSTGRES_DB=ogc
POSTGRES_USER=ogc
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET

# Redis (internal network only; never published).
REDIS_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET

# Email (required for verification and password recovery). `disabled` = recovery answers
# "unavailable". SMTP must use TLS in production.
EMAIL_TRANSPORT=disabled
# EMAIL_FROM=OGC <no-reply@mail.your-domain>
# SMTP_HOST=smtp.your-provider
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=REPLACE
# SMTP_PASSWORD=REPLACE_WITH_THE_PROVIDER_CREDENTIAL

# Push (Expo → FCM/APNs). `disabled` until credentials are uploaded with `eas credentials`.
PUSH_PROVIDER=disabled
# EXPO_ACCESS_TOKEN=REPLACE

# Metrics (blocked at the edge; scrape from the host). ≥ 32 random characters, or leave unset.
# METRICS_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_32_CHARACTERS_OR_MORE

# Calls (optional). TURN uses the coturn REST-API shared secret.
# WEBRTC_STUN_URLS=stun:turn.your-domain:3478
# WEBRTC_TURN_URLS=turn:turn.your-domain:3478?transport=udp,turns:turn.your-domain:443?transport=tcp
# WEBRTC_TURN_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# WEBRTC_ICE_TRANSPORT_POLICY=all

# Rarely changed.
# LOG_LEVEL=info
# TRUST_PROXY_HOPS=1        # raise only if a load balancer or CDN sits in front of the edge
# HTTP_PORT=80
# HTTPS_PORT=443
# PUBLIC_BIND=0.0.0.0
