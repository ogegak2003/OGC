# Dependencies
node_modules/
.pnpm-store/

# Environment — never commit real values
.env
.env.*
!.env.example

# Build output
dist/
build/
out/
*.tsbuildinfo

# Framework / tool caches
.turbo/
.next/
.expo/
.expo-shared/
web-build/
.vite/
.eslintcache

# Generated code
apps/api/src/generated/

# Native build artifacts (Expo prebuild)
apps/mobile/android/
apps/mobile/ios/
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
# EAS local credentials (passwords) and credentials downloaded by `eas credentials`
apps/mobile/credentials.json
apps/mobile/credentials/
# Firebase / push credentials (provided to builds through EAS environment variables)
google-services.json
GoogleService-Info.plist
*-firebase-adminsdk-*.json

# Development email outbox (may contain verification links)
.dev-outbox/
.dev-storage/

# Testing
coverage/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# Local Android build toolchain (JDK, Android SDK) — never committed
.toolchain/

# Backups and backup keys — never commit (infrastructure/backup/README.md)
*.dump
*.dump.gpg
*.env.gpg
*.sha256
backups/
*.gpg
*.asc

# Deployment env files (secrets): keep outside the repo; ignored here as a safety net
*.env
!*.env.example
